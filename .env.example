# Côté serveur uniquement (Vercel → Settings → Environment Variables), utilisées par api/*.ts
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
BEDS24_TOKEN=
CRON_SECRET=
# Réservation en ligne (api/checkout, api/stripe-webhook, api/booking-status).
# Le paiement n'apparaît sur le site que si les deux clés Stripe sont présentes.
STRIPE_SECRET_KEY=          # sk_test_… (test) puis sk_live_… (production)
STRIPE_WEBHOOK_SECRET=      # whsec_… du webhook https://<site>/api/stripe-webhook
# ONLINE_BOOKING=off        # coupe le paiement en ligne sans retirer les clés
# BEDS24_REFRESH_TOKEN=     # facultatif : crée les réservations payées dans Beds24 (refresh token tiré d'un code d'invitation avec le droit d'écriture des réservations ; voir README)
# E-mails (api/_lib/email.ts, via Resend). Sans RESEND_API_KEY, rien n'est envoyé.
RESEND_API_KEY=             # re_… clé « Sending access » limitée au domaine d'envoi
OWNER_EMAIL=                # reçoit les alertes : réservation payée, demande du formulaire, paiement à rembourser
# EMAIL_FROM=               # « Château Latour Ségur <reservations@mail.chambredhotesaintemilion.fr> », une fois le domaine vérifié dans Resend ; sans lui, pas de confirmation au client
# EMAIL_REPLY_TO=           # contact@chateaulatoursegur.com par défaut
VITE_RYBBIT_SITE_ID=a2172317d5a1
